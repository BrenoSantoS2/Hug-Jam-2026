  m_Script: {fileID: 11500000, guid: 085b23a76a9f38d459354a538d659dd0, type: 3}
  m_Name: DialogueBank level 1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueBank
  entries:
  - type: 0
    dialogues:
    - Uma feijoada!!
    - "Esta Mucho, mas d\xE1 pra comer"
    - "Um sandu\xEDche pela metade, melhor que rato frito"
    - Tive sorte, a marmita ta quase inteira!
  - type: 1
    dialogues:
    - 'nada, os lixeiros devem ter passado '
    - Podre, poderiam ao menos separar a comida do resto
    - Sobra nada para gente
    - Mais vazio que meus bolsos
  - type: 2
    dialogues:
    - Preciso me esconder!
    - "Tenho que ser r\xE1pido, eles est\xE3o perto!"
    - "N\xE3o posso deixar aquilo me pegar!"
  - type: 3
    dialogues:
    - Preciso ter cautela, eles podem voltar a qualquer momento!
    - "Acho que eles j\xE1 foram!"
    - Estou ficando velho pra isso!
  - type: 4
    dialogues:
    - 'Meu senhor, aceite um pouco do que tenho, espero que ajude! '
    - tome uum pouco de comida e se abrigue
    - "Gostaria de poder ajudar mais , isto \xE9 o que eu tenho, espero que ajude "
  - type: 5
    dialogues:
    - "T\xE1 achando que isso \xE9 a caridade, sai fora!"
    - "Tu n\xE3o tem vergonha de bater na porta h\xE1 est\xE1 hora? "
    - "Se voc\xEA arrumar um emprego n\xE3o precisa me incomodar pedindo"
